{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "observation.schema.json",
  "title": "Observations returned by JudgeEnv.reset (first) and JudgeEnv.step (every later one)",
  "oneOf": [
    {
      "$ref": "#/$defs/first"
    },
    {
      "$ref": "#/$defs/step"
    }
  ],
  "$defs": {
    "first": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task",
        "manifest",
        "policy",
        "remaining_steps"
      ],
      "properties": {
        "task": {
          "type": "string"
        },
        "manifest": {
          "$ref": "#/$defs/manifest"
        },
        "policy": {
          "type": "object",
          "required": [
            "policy_version"
          ],
          "description": "The published policy (rules and finding conventions) the episode is judged by."
        },
        "remaining_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "error",
        "remaining_steps"
      ],
      "properties": {
        "result": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/page"
            },
            {
              "$ref": "#/$defs/ledger_row"
            },
            {
              "$ref": "#/$defs/invoice"
            },
            {
              "$ref": "#/$defs/payment"
            },
            {
              "$ref": "#/$defs/fx_row"
            },
            {
              "$ref": "#/$defs/decimal"
            },
            {
              "$ref": "#/$defs/accepted"
            }
          ],
          "description": "null whenever error is set, and when the time limit ended the episode."
        },
        "error": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/error"
            }
          ]
        },
        "remaining_steps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "action_too_large",
            "bad_arguments",
            "bad_cursor",
            "bad_limit",
            "calc_div_zero",
            "calc_overflow",
            "calc_syntax",
            "calc_too_deep",
            "calc_too_long",
            "episode_over",
            "internal_error",
            "invalid_action",
            "invalid_submission",
            "unknown_action",
            "unknown_id",
            "unknown_table"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "accepted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted"
      ],
      "properties": {
        "accepted": {
          "const": true
        }
      },
      "description": "A valid submit. It says nothing about correctness."
    },
    "decimal": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "description": "calculator result, an exact decimal string such as \"0.3\"."
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "records",
        "next_cursor"
      ],
      "properties": {
        "records": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/ledger_row"
              },
              {
                "$ref": "#/$defs/invoice"
              },
              {
                "$ref": "#/$defs/payment"
              },
              {
                "$ref": "#/$defs/fx_row"
              }
            ]
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ledger_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "timestamp",
        "account",
        "debit_minor",
        "credit_minor",
        "currency",
        "entity_id",
        "invoice_id",
        "payment_id"
      ],
      "properties": {
        "row_id": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "account": {
          "type": "string"
        },
        "debit_minor": {
          "type": "integer",
          "minimum": 0
        },
        "credit_minor": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "type": "string"
        },
        "entity_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "invoice_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "payment_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "line_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "quantity",
        "unit_price_minor",
        "amount_minor"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "quantity": {
          "type": "integer"
        },
        "unit_price_minor": {
          "type": "integer"
        },
        "amount_minor": {
          "type": "integer"
        }
      }
    },
    "invoice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc_id",
        "invoice_id",
        "entity_id",
        "issued_at",
        "due_at",
        "currency",
        "total_minor",
        "line_items"
      ],
      "properties": {
        "doc_id": {
          "type": "string"
        },
        "invoice_id": {
          "type": "string"
        },
        "entity_id": {
          "type": "string"
        },
        "issued_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "due_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "currency": {
          "type": "string"
        },
        "total_minor": {
          "type": "integer"
        },
        "line_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/line_item"
          }
        }
      }
    },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc_id",
        "payment_id",
        "timestamp",
        "currency",
        "amount_minor",
        "invoice_refs"
      ],
      "properties": {
        "doc_id": {
          "type": "string"
        },
        "payment_id": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "currency": {
          "type": "string"
        },
        "amount_minor": {
          "type": "integer"
        },
        "invoice_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "fx_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "source_currency",
        "target_currency",
        "rate"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "source_currency": {
          "type": "string"
        },
        "target_currency": {
          "type": "string"
        },
        "rate": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "A decimal string: target units per one source unit."
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "episode_id",
        "base_currency",
        "period_start",
        "period_end",
        "timezone",
        "counts",
        "currencies",
        "rounding",
        "amount_tolerance_minor",
        "issue_types",
        "limits"
      ],
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "episode_id": {
          "type": "string"
        },
        "base_currency": {
          "type": "string"
        },
        "period_start": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "period_end": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "timezone": {
          "type": "string"
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ledger_rows",
            "documents",
            "fx_rates"
          ],
          "properties": {
            "ledger_rows": {
              "type": "integer"
            },
            "documents": {
              "type": "integer"
            },
            "fx_rates": {
              "type": "integer"
            }
          }
        },
        "currencies": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "exponent"
            ],
            "properties": {
              "exponent": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "rounding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "permitted",
            "default"
          ],
          "properties": {
            "permitted": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "default": {
              "type": "string"
            }
          }
        },
        "amount_tolerance_minor": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "description": "tau per currency: abs(claimed - expected) <= tau. 0 in every episode we generate."
        },
        "issue_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_steps",
            "page_limit",
            "max_findings",
            "max_evidence_ids",
            "max_explanation_chars"
          ],
          "properties": {
            "max_steps": {
              "type": "integer",
              "minimum": 1
            },
            "page_limit": {
              "type": "integer",
              "minimum": 1
            },
            "max_findings": {
              "type": "integer",
              "minimum": 1
            },
            "max_evidence_ids": {
              "type": "integer",
              "minimum": 1
            },
            "max_explanation_chars": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
